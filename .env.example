# AI Document Intelligence & Workflow Platform — environment variables
# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and must NEVER be committed to version control.

# ── AI / RAG ──────────────────────────────────────────────────────────────
# Google Gemini API key (optional — the app works without it using local
# retrieval-only mode; get a free key at https://aistudio.google.com)
GEMINI_API_KEY=

# Gemini model to use for answer generation
GEMINI_MODEL=gemini-1.5-flash

# Sentence-transformer model for local embeddings (no API key required)
EMBED_MODEL_NAME=all-MiniLM-L6-v2

# RAG retrieval settings
RAG_TOP_K=5
RAG_CHUNK_SIZE=300
RAG_CHUNK_OVERLAP=50

# ── Workflow ───────────────────────────────────────────────────────────────
# Confidence threshold below which documents are routed for human review
LOW_CONFIDENCE_THRESHOLD=0.55

# ── Storage ────────────────────────────────────────────────────────────────
# Override default paths (leave blank to use project defaults)
DB_PATH=
STORAGE_ROOT=

# ── Upload limits ──────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=10485760
